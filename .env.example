# 前端服务端口
VITE_FE_PORT=9000

# 基座配色主题，未配置或为空时默认使用 cream
VITE_COLOR_THEME=cream

# 基座后端 API 的固定地址（通过 /api/cdi 代理访问）
CDI_UPSTREAM_BASE_URL=<your_cdi_upstream_base_url>

# Google Auth
VITE_GOOGLE_CLIENT_ID=<your_google_client_id>
# 灰度开关
VITE_GOOGLE_LOGIN_ENABLED=true

# 覆盖默认 i18n 文案。必须是单行合法 JSON；只会覆盖已有的字符串 key。
# VITE_CONTENT_OVERRIDE='{"en-US":{"nav":{"cam":"CAM API Management"}},"zh-CN":{"nav":{"cam":"CAM API 管理"}}}'

# 外部静态首页；留空使用默认首页。容器运行时读取，开发/预览修改后重启。
CDI_HOME_PAGE_URL=
