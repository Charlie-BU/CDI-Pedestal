# 前端服务端口
VITE_FE_PORT=9000

# CAM 远程入口 URL
VITE_CAM_REMOTE_ENTRY=http://<cam_remote_entry_url>/mf-manifest.json

# CAM 原始后端 Base URL（被 Vite/Caddy 代理至 /api/cam）
CAM_UPSTREAM_BASE_URL=<your_cam_upstream_base_url>
# 其他 app 原始后端 Base URL（被 Vite/Caddy 代理至 /api/xxx）
# ...

# Google Auth
VITE_GOOGLE_CLIENT_ID=<your_google_client_id>
# 灰度开关
VITE_GOOGLE_LOGIN_ENABLED=true

# 覆盖默认 i18n 文案。必须是单行合法 JSON；只会覆盖已有的字符串 key。
# VITE_CONTENT_OVERRIDE='{"en-US":{"nav":{"cam":"CAM API Management"}},"zh-CN":{"nav":{"cam":"CAM API 管理"}}}'

# 隐藏指定菜单及其对应路由。使用菜单 path（也兼容不带 / 的名称），必须是单行合法 JSON 数组。
# VITE_HIDE_MENUS='["/cam", "/railway"]'
