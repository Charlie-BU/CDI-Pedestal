{
    admin off
    persist_config off
    auto_https off
}

:{$PORT:8080} {
    root * /srv
    encode gzip
    header Cross-Origin-Opener-Policy "same-origin-allow-popups"

    @health path /health
    respond @health "OK" 200

    # CAM API
    handle_path /api/cam/* {
        reverse_proxy {$CAM_UPSTREAM_BASE_URL}
    }

    handle {
        route {
            try_files {path} /index.html
            @document path /index.html /
            header @document {
                Cache-Control "private, no-store"
                Vary "X-LOCAL-DEBUG"
            }
            templates {
                mime text/html
            }
            file_server
        }
    }
}
